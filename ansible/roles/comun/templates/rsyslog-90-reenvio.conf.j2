# {{ ansible_managed }} (rol comun, R12)
{% if comun_rsyslog_archivos %}
# Archivos que un servicio escribe por su cuenta; entran con su etiqueta y se
# reenvían como el resto
module(load="imfile")
{% for a in comun_rsyslog_archivos %}
input(type="imfile" file="{{ a.ruta }}" tag="{{ a.etiqueta }}:" facility="{{ a.facilidad | default('user') }}" severity="notice")
{% endfor %}

{% endif %}
# Reenvío por TCP a kit01 con cola en disco, para no perder eventos si kit01 no
# responde. ForwardFormat conserva la hora con fracciones de segundo y zona.
*.* action(type="omfwd" target="{{ comun_rsyslog_destino }}" port="514" protocol="tcp"
           template="RSYSLOG_ForwardFormat"
           queue.type="LinkedList" queue.filename="reenvio" queue.saveOnShutdown="on"
           action.resumeRetryCount="-1")
