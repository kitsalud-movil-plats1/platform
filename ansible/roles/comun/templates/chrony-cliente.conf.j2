# {{ ansible_managed }} (rol comun, R3)
# Única fuente de hora: el servidor del kit en kit01
server {{ comun_chrony_servidor }} iburst

keyfile /etc/chrony/chrony.keys
driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony
logdir /var/log/chrony
maxupdateskew 100.0
rtcsync
makestep 1 3
leapsectz right/UTC
