{% set cuerpo %}
@	IN	NS	ns1.{{ dns_zona }}.
{% for d in dns_delegaciones %}
{% for ns in d.ns %}
{{ d.nombre }}	IN	NS	{{ ns }}.{{ dns_zona }}.
{% endfor %}
{% endfor %}
{% for r in dns_registros %}
{{ r.nombre }}	IN	A	{{ r.ipv4 }}
{% if r.ipv6 is defined %}
{{ r.nombre }}	IN	AAAA	{{ r.ipv6 }}
{% endif %}
{% endfor %}
{% endset %}
; {{ ansible_managed }} (rol bind9, sección 9)
; El serial sale del contenido: cambia solo si cambian los registros.
$TTL {{ bind9_ttl }}
@	IN	SOA	ns1.{{ dns_zona }}. hostmaster.{{ dns_zona }}. (
		{{ (cuerpo | hash('md5'))[:7] | int(base=16) }} ; serial
		3600 600 604800 300 )
{{ cuerpo }}
