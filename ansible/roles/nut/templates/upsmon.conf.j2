# {{ ansible_managed }} (rol nut, platform#13)
# kit01 es el único equipo con la UPS. Con la UPS en batería (OB) y batería
# baja (LB) marca FSD y ejecuta kit-apagado, que apaga las VMs en orden y
# después kit01
MONITOR {{ nut_ups }}@localhost 1 upsmon {{ vault_nut_password }} primary
MINSUPPLIES 1
SHUTDOWNCMD "/usr/local/sbin/kit-apagado"
POWERDOWNFLAG /etc/killpower
POLLFREQ 5
POLLFREQALERT 5
HOSTSYNC 15
DEADTIME 15
FINALDELAY 5
RUN_AS_USER nut

NOTIFYFLAG ONLINE SYSLOG
NOTIFYFLAG ONBATT SYSLOG
NOTIFYFLAG LOWBATT SYSLOG
NOTIFYFLAG FSD SYSLOG
NOTIFYFLAG COMMOK SYSLOG
NOTIFYFLAG COMMBAD SYSLOG
NOTIFYFLAG SHUTDOWN SYSLOG
NOTIFYFLAG NOCOMM SYSLOG
