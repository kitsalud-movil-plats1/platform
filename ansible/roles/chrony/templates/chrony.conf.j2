# {{ ansible_managed }} (rol chrony, R3)
# Servidor NTP del kit en la IP de servicios (ntp.salud.movil)
pool {{ chrony_pool }} iburst maxsources 4

# Sin Internet, kit01 sigue siendo la referencia de hora del kit
local stratum 10 orphan

# Solo responde a las redes internas y solo en la IP de servicios
allow {{ red_kit4 }}
allow {{ ula_kit6 }}
bindaddress {{ servicios_kit01.ipv4 }}
bindaddress {{ servicios_kit01.ipv6 }}

keyfile /etc/chrony/chrony.keys
driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony
logdir /var/log/chrony
maxupdateskew 100.0
rtcsync
makestep 1 3
leapsectz right/UTC
